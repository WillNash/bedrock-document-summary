# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

# ─────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────

project_name = "bedrock-doc-summary"

# ─────────────────────────────────────────────
# Optional overrides (defaults shown)
# ─────────────────────────────────────────────

aws_region  = "us-east-1"
environment = "prod"

# Bedrock model IDs — must use a geo or global inference profile prefix.
# Do NOT use bare model IDs (anthropic.claude-*) — they will fail at runtime.
bedrock_model_id            = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
bedrock_classifier_model_id = "us.anthropic.claude-haiku-4-5-20251001-v1:0"

# ─────────────────────────────────────────────
# Two-step deployment for Cognito callback URLs
# ─────────────────────────────────────────────
#
# Step 1: Run terraform apply with these placeholder localhost values (the defaults
#         are already set in variables.tf, so you can skip this block on first apply).
#         Note the cloudfront_url output after apply completes.
#
# Step 2: Uncomment and update the lines below with the real CloudFront URL,
#         then run terraform apply again. Only the Cognito App Client is updated.
#
# cognito_callback_urls = ["https://REPLACE_WITH_CLOUDFRONT_URL/callback"]
# cognito_logout_urls   = ["https://REPLACE_WITH_CLOUDFRONT_URL"]

cognito_callback_urls = ["http://localhost:3000/callback"]
cognito_logout_urls   = ["http://localhost:3000"]

log_retention_days    = 30
upload_max_size_bytes = 10485760  # 10 MB

# Optional: set to receive CloudWatch alarm notifications and cost anomaly alerts
# alert_email = "ops@example.com"

tags = {
  Team = "engineering"
}

# ─────────────────────────────────────────────
# Fallback: aws_bedrock_prompt not available (provider < 5.50)
# ─────────────────────────────────────────────
# If your environment pins to an older AWS provider version and aws_bedrock_prompt
# resources fail, run scripts/seed_prompts.sh to create prompts via CLI and
# pass the returned ARNs and versions as variables here (add corresponding
# variable declarations to variables.tf and update bedrock.tf accordingly).
